{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://kwkvzmsnmjoqjllfjoew.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "qit-concierge-mcp",
      "version": "0.1.0",
      "title": "Qit Concierge"
    },
    "tools": [
      {
        "name": "list_properties",
        "title": "List properties",
        "description": "List Qit Concierge properties (managed short-term rentals in Drôme-Ardèche). Returns active listings visible on the public site.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "active_only": {
              "description": "If true, only return active listings. Defaults to true.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max number of rows to return. Defaults to 50.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_estimation_request",
        "title": "Create estimation request",
        "description": "Create a new free-estimation lead for Qit Concierge (owner asking for a revenue estimation of their short-term rental).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string",
              "minLength": 3,
              "maxLength": 40
            },
            "city": {
              "type": "string",
              "maxLength": 120
            },
            "property_type": {
              "type": "string",
              "maxLength": 60
            },
            "beds": {
              "type": "string",
              "maxLength": 20
            },
            "surface": {
              "type": "string",
              "maxLength": 20
            },
            "platform": {
              "type": "string",
              "maxLength": 60
            },
            "online_status": {
              "type": "string",
              "maxLength": 60
            },
            "listing_url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            },
            "goal": {
              "type": "string",
              "maxLength": 500
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "name",
            "email",
            "phone"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_estimation_requests",
        "title": "List estimation requests",
        "description": "List incoming free-estimation leads. Admin only — RLS returns rows only for signed-in admin users.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status (e.g. 'new', 'contacted').",
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
